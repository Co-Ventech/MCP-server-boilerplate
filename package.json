{
  "name": "mcp-server-boilerplate",
  "version": "0.1.0",
  "description": "GitHub template for building an MCP server: end-to-end tests against a real client, tag-to-npm release workflow, add a tool by adding one file.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Co-Ventech/MCP-server-boilerplate.git"
  },
  "bugs": {
    "url": "https://github.com/Co-Ventech/MCP-server-boilerplate/issues"
  },
  "homepage": "https://github.com/Co-Ventech/MCP-server-boilerplate#readme",
  "bin": {
    "mcp-server-boilerplate": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "npm run build && node --test test/*.test.js",
    "inspect": "npx --no-install @modelcontextprotocol/inspector node dist/index.js",
    "prepublishOnly": "npm test",
    "rename": "node scripts/rename.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "boilerplate",
    "template",
    "server"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/inspector": "^2.5.0",
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2"
  }
}
